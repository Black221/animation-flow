# Copy to .env (never committed) and fill in.
# 32 random bytes, base64: openssl rand -base64 32
APP_ENCRYPTION_KEY=
# PostgreSQL password used by docker compose
POSTGRES_PASSWORD=change-me
# Who may create an account: invite (the first account, then invited people) or open (anyone)
SIGNUP=invite
# Force the Secure flag on the session cookie (true when served over HTTPS; default: detected)
COOKIE_SECURE=
# Port on this machine
PORT=3000
# Threads per render job (empty: CPU count − 1)
RENDER_THREADS=
# Behind a reverse proxy or load balancer: true, a number of hops, or its addresses. Leave empty when the app is
# reached directly (a client could otherwise choose the address it is seen from)
TRUST_PROXY=
# E-mail (optional): invitations sent by e-mail and forgotten-password links. All three together.
# SMTP_URL=smtps://user:password@smtp.example.org:465
# MAIL_FROM=animation-flow <noreply@example.org>
# APP_URL=https://anim.example.org
SMTP_URL=
MAIL_FROM=
APP_URL=
# Plans and quotas: on (Gratuit, Basique, Premium, Pro) or off (nothing limited: a private server)
PLANS=on
# Paying for a plan with Stripe (optional): all five together, with APP_URL. The webhook's endpoint is
# APP_URL/api/billing/webhook (events: checkout.session.completed, customer.subscription.*, invoice.payment_failed)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_PRO=
# The back office, a server of its own: on (3001) or off, the port it gets on this machine (docker-compose.yml publishes
# it on 127.0.0.1 only), its public address (a link for platform admins), the addresses allowed to reach it
ADMIN_PORT=3001
ADMIN_HOST_PORT=3001
ADMIN_URL=
ADMIN_ALLOWED_IPS=
