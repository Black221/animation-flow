# Copy to .env (never committed) and fill in.
# 32 random bytes, base64: openssl rand -base64 32
APP_ENCRYPTION_KEY=
# PostgreSQL password used by docker compose
POSTGRES_PASSWORD=change-me
# Who may create an account: invite (the first account, then invited people) or open (anyone)
SIGNUP=invite
# Force the Secure flag on the session cookie (true when served over HTTPS; default: detected)
COOKIE_SECURE=
# Port on this machine
PORT=3000
# Threads per render job (empty: CPU count − 1)
RENDER_THREADS=
