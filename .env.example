# Copy to .env (never committed) and fill in.
# 32 random bytes, base64: openssl rand -base64 32
APP_ENCRYPTION_KEY=
# PostgreSQL password used by docker compose
POSTGRES_PASSWORD=change-me
# Optional shared access token for the team (leave empty for none)
APP_ACCESS_TOKEN=
# Port on this machine
PORT=3000
# Threads per render job (empty: CPU count − 1)
RENDER_THREADS=
